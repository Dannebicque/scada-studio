{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scada-studio.local/schemas/extension-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "apiVersion",
    "displayName",
    "capabilities",
    "configSchema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "kind": {
      "enum": [
        "connector",
        "widget",
        "chart",
        "symbol",
        "ai-provider"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "apiVersion": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "configSchema": {
      "type": "object"
    }
  }
}
